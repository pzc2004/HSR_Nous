# ══ LLM 配置（全项目统一 HSR_NOUS_LLM_<用途>_ 前缀；均为 OpenAI 兼容协议）══
# 统一接入层 = src/hsr_nous/llm/（tribios/缇里西庇俄丝）：
# API_KEY 支持逗号分隔多 key（每 key 独立并发额度）；CONCURRENCY=每 key 并发上限（默认 4）。

# ── AGENTS 组：agents 层（autoresearch 探索闭环）用（重做后读这组；
#    历史代码读 OPENAI_* 属遗留，不再维护）──
# 默认建议 DeepSeek V4 Flash（$0.14/1M input, $0.28/1M output），也可指向其他兼容端点
HSR_NOUS_LLM_AGENTS_API_KEY=
HSR_NOUS_LLM_AGENTS_MODEL=deepseek-v4-flash
HSR_NOUS_LLM_AGENTS_API_BASE=https://api.deepseek.com
HSR_NOUS_LLM_AGENTS_CONCURRENCY=4

# ── ANNOTATOR 组：打标 DAG 用（ops/annotator）──
# 任意 OpenAI 兼容端点均可；建议选支持 reasoning effort 透传的模型，
# effort=max 时 reasoning 会消耗 max_tokens 预算，输出额度要给足。
HSR_NOUS_LLM_ANNOTATOR_API_KEY=   # 逗号分隔多 key
HSR_NOUS_LLM_ANNOTATOR_MODEL=
HSR_NOUS_LLM_ANNOTATOR_API_BASE=
HSR_NOUS_LLM_ANNOTATOR_EFFORT=
HSR_NOUS_LLM_ANNOTATOR_CONCURRENCY=4
# 厂商扩展请求头（JSON 对象字符串，逐请求并入——端点要求特殊头时填）：
# HSR_NOUS_LLM_ANNOTATOR_EXTRA_HEADERS={"X-Header": "value"}
# 号池（JSON 数组的端点画像，按序 failover——auth/余额确定性死才换下一槽，
# 429/5xx 槽内退避不换槽；空 = 上面单端点）：
# HSR_NOUS_LLM_ANNOTATOR_POOL=[{"api_base": "...", "model": "...", "api_key": "..."}]

# Mihoyo 账号集成（HSR_NOUS_ 前缀避免与系统变量冲突）
# ltuid / ltoken 是米游社通行证 cookie 的两个值；用 .env 是 fallback，
# 推荐用 `keyring` 保存（见 docs/integrations.md）。仓库根 .env 由 account
# 模块自动加载（已存在的环境变量优先；keyring 优先于两者）。
HSR_NOUS_HOYO_LTUID=
HSR_NOUS_HOYO_LTOKEN=
HSR_NOUS_HOYO_SERVER=cn_gf01   # cn_gf01 / cn_qd01 / os_asia / os_euro / os_america
# 可选：设备身份缺省自动生成并永久复用（首次拉取经米哈游 getFp 端点签发，存
# ~/.config/hsr_nous/device_identity.json）——以下仅风控排查时覆写可信旧值：
# HSR_NOUS_HOYO_DEVICE_ID=
# HSR_NOUS_HOYO_DEVICE_FP=
