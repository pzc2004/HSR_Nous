# LLM 接入（OpenAI 兼容协议，可指向 Claude 代理）
OPENAI_API_KEY=
OPENAI_MODEL=claude-opus-4.8
OPENAI_API_BASE=

# Mihoyo 账号集成（HSR_NOUS_ 前缀避免与系统变量冲突）
# ltuid / ltoken 是米游社通行证 cookie 的两个值；用 .env 是 fallback，
# 推荐用 `keyring` 保存（见 docs/INTEGRATIONS.md）。
HSR_NOUS_HOYO_LTUID=
HSR_NOUS_HOYO_LTOKEN=
HSR_NOUS_HOYO_SERVER=cn_gf01   # cn_gf01 / cn_qd01 / os_asia / os_euro / os_america

# 自动战斗执行层（默认关闭，开启=接受 ToS 风险）
HSR_NOUS_ALLOW_AUTOPILOT=0
HSR_NOUS_SCREEN_CAPTURE_BACKEND=mss