# 打标专用隔离配置家（打标装备第二档）
# 启动：KIMI_CODE_HOME=~/.kimi-code-annotator kimi
# 首次使用先 /login（登录态与主配置互不影响；providers/models 由 /login 自动配齐）
default_permission_mode = "auto"

# ---- 权限规则（按序匹配，首条命中生效）----
# 本会话全员打标形态：Bash 只有 dispatcher 一个面；合并/提交回日常会话做
[[permission.rules]]
decision = "allow"
pattern = "Bash(bash scripts/annotator.sh*)"

[[permission.rules]]
decision = "deny"
pattern = "Bash"

# 写/编只放 data/annotator/**（Edit/Write 路径 pattern 同 Read(path-pattern) 形状，上线先验证一条）
[[permission.rules]]
decision = "allow"
pattern = "Edit(data/annotator/**)"

[[permission.rules]]
decision = "deny"
pattern = "Edit"

[[permission.rules]]
decision = "allow"
pattern = "Write(data/annotator/**)"

[[permission.rules]]
decision = "deny"
pattern = "Write"

# 读与调研显式放行（本为默认；写下便于审计）
[[permission.rules]]
decision = "allow"
pattern = "Read"

[[permission.rules]]
decision = "allow"
pattern = "WebSearch"

[[permission.rules]]
decision = "allow"
pattern = "FetchURL"

# ---- 模型配置 ----
# providers/models 由 /login 自动配齐（厂商/* 别名）；本节只管子代理池：
# 打标工（annotator 子代理）默认走低费高速模型，主代理（编排）保持强模型
[secondary_model]
default_model = "vendor/fast-model"
[secondary_model.models]
"vendor/fast-model" = "打标工默认：结构化产出型任务（模板撰写/修订）"
"vendor/strong-model" = "难例兜底：机制链特别绕/多次返工的角色"
# =============================================================================
# 打标装备隔离配置家模板（annotator rig home template）
#
# 用法：
#   1. cp scripts/annotator_home.config.toml.example ~/.kimi-code-annotator/config.toml
#   2. KIMI_CODE_HOME=~/.kimi-code-annotator kimi   # 起打标会话
#   3. /login                                        # 登录一次（key 由登录流注入，不进库）
#
# 本文件只含非密配置（权限规则/模型池/权限模式）——providers/models 凭据由
# /login 自动配齐，真实 config.toml 永远留在本机 home、不进 git。
# =============================================================================
