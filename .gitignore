# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
# 例外：pipeline 配装域包（`src/hsr_nous/pipeline/build/`——P1 三域归置的源代码目录，
# 非构建产物，入版本）
!src/hsr_nous/pipeline/build/

# Data files (game data, not source code)
data/*
# 例外：机制库（`data/library/`——手写全机制 DSL 模板正典 + 命途系统模块，入版本）
# 与对局配置库（`data/battles/`——策展 build/stage 配置，入版本）
!data/library/
!data/battles/
# 例外之例外：golden 对拍材料（视频/截图/JSON 元数据——真实 golden 分析为后置项，暂不入版本）
data/battles/golden/

# Virtual environment
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.log

# Mechanics scan reports (one-off research output, regenerated by scripts)
reports/

# Design proposals (in flux, tracked when finalized as sim_schema/docs/*.md)
designs/

# Agent
agent/learn/
agent/plans
*.env

# OMC (oh-my-claudecode) local state
.omc/

